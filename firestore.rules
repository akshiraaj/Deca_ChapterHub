rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Config (holds the exec code). Never directly readable by clients,
    // but rules below can still check it via get(). ----
    match /config/execCode {
      allow read, write: if false;
    }

    // ---- Member profiles ----
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // ---- Exec allowlist. Anyone signed in (incl. anonymous) can attempt to
    // register themselves as an exec, but the write is only accepted if the
    // "code" field they submit matches config/execCode. ----
    match /execs/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.code == get(/databases/$(database)/documents/config/execCode).data.value;
      allow update, delete: if false;
    }

    // ---- Points: anyone can read (for the leaderboard), only execs can add ----
    match /points/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/execs/$(request.auth.uid));
      allow update, delete: if false;
    }

    // ---- Attendance: anyone can read, only execs can add ----
    match /attendance/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/execs/$(request.auth.uid));
      allow update, delete: if false;
    }

    // ---- Spotlights: anyone can read, only execs can add ----
    match /spotlights/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/execs/$(request.auth.uid));
      allow update, delete: if false;
    }

    // ---- Feedback: anyone can submit, only execs can read (privacy) ----
    match /feedback/{id} {
      allow create: if true;
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/execs/$(request.auth.uid));
      allow update, delete: if false;
    }
  }
}
